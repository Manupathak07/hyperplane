# HyperPlane — environment defaults for docker-compose
# Copy to `.env` (gitignored) and edit for your machine.
# Anything left unset falls back to the docker-compose default.

POSTGRES_USER=hyperplane
POSTGRES_PASSWORD=hyperplane_dev
POSTGRES_DB=hyperplane

# LLM
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b

# Frontend talks to backend at http://localhost:8000
VITE_API_BASE=http://localhost:8000

# Week 4 — ingestion auth. Must match between backend + generator.
# In dev we use a shared placeholder; rotate before any real deploy.
EVENTS_API_KEY=dev-shared-key-change-me

# Week 4 — generator tuning
# GEN_MODE: PURE_RANDOM | SCENARIO_CORRELATED
GEN_MODE=SCENARIO_CORRELATED
GEN_BATCH_SIZE=4
GEN_INTERVAL_SEC=8
GEN_MAX_BATCHES=0

# Week 6 — Threat Intel providers. Leave empty to use the deterministic
# IP-heuristic fallback (RFC5737 + private). Set both to enable live
# OTX + AbuseIPDB lookups; results are cached for THREATINTEL_CACHE_TTL_S.
OTX_API_KEY=
ABUSEIPDB_API_KEY=
THREATINTEL_CACHE_TTL_S=3600